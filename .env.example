# Copy this file to `.env` and fill in real values.
# See README.md > "Conectando o banco de dados" for setup instructions.

# Postgres connection strings, split per Supabase/Prisma's recommendation
# for serverless: DATABASE_URL (runtime, used by src/lib/prisma.ts) uses the
# "Transaction pooler" (port 6543) -- built for many short-lived
# connections, unlike the "Session pooler" which caps total clients low.
# DIRECT_URL (migrations only, used by prisma.config.ts) uses the "Session
# pooler" (port 5432): Prisma Migrate needs DDL/shadow-database support the
# transaction pooler doesn't provide.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-32-byte-random-secret"

# Supabase project credentials. Not consumed by app code yet (the app talks
# to Postgres directly via Prisma), kept here for when you wire up
# Supabase-specific features (Storage, Realtime, Auth, etc.).
SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
